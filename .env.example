# Telegram bot (faqat serverda o'qiladi — VITE_ prefiksi QO'YMANG, aks holda token brauzerga chiqadi)
# 1) @BotFather → /newbot → tokenni oling
# 2) Botni arizalar keladigan guruhga qo'shing (yoki botga o'zingiz /start yozing)
# 3) chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates dan "chat":{"id":...} ni oling
#    (guruh id'si odatda -100 bilan boshlanadi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ixtiyoriy: arizalarni boshqa backendga yuborish (standart: /api/lead)
VITE_LEAD_ENDPOINT=
